# Sao chép thành .env (chạy trên máy) hoặc nhập từng biến vào Render → Environment (bản deploy).
# KHÔNG commit file .env thật.

PORT=5000

# Chuỗi kết nối MongoDB. Máy: mongodb://127.0.0.1:27017/slothub_demo
# Deploy: MongoDB Atlas, VD mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/slothub
MONGODB_URI=

# Khóa ký JWT: chuỗi ngẫu nhiên dài (đổi khóa → mọi người phải đăng nhập lại)
JWT_SECRET=

# Link frontend đã deploy (dùng khi trang thanh toán payOS quay về), VD https://slothub.vercel.app
FRONTEND_URL=

# Upload ảnh - Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gửi email (Gmail + App Password)
EMAIL_USER=
EMAIL_PASS=

# Bản deploy trên Render Free: Render CHẶN SMTP (cổng 25/465/587) → gửi mail qua API Brevo.
# Có BREVO_API_KEY thì gửi qua Brevo (người gửi = EMAIL_FROM hoặc EMAIL_USER, phải xác minh trong Brevo → Senders).
# Bỏ trống khi chạy trên máy → dùng Gmail SMTP ở trên.
BREVO_API_KEY=
EMAIL_FROM=

# Chatbot AI - Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Đăng nhập Google (trùng REACT_APP_GOOGLE_CLIENT_ID của frontend)
GOOGLE_CLIENT_ID=

# Thanh toán - PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
