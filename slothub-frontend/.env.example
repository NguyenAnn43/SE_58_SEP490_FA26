# Chỉ cần khi deploy (Vercel → Settings → Environment Variables). Chạy trên máy không cần file này.
# Sau khi đổi biến phải build/deploy lại thì mới có hiệu lực.

# Link backend + /api, VD https://slothub-api.onrender.com/api
REACT_APP_API_URL=

# Google OAuth Client ID (Google Cloud Console → Credentials). Bỏ trống = dùng ID mặc định trong App.js
REACT_APP_GOOGLE_CLIENT_ID=
